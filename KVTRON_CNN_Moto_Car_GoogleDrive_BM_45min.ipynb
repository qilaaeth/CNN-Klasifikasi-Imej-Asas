      "source": [
        "if model is None:\n",
        "    print(\"[BELUM SEDIA] Lengkapkan model dahulu.\")\n",
        "    criterion = optimizer = epochs = None\n",
        "else:\n",
        "    criterion = nn.CrossEntropyLoss()   # FIX ME: nn.CrossEntropyLoss()\n",
        "    optimizer = optim.Adam(model.parameters(), lr=0.001)  # FIX ME: optim.Adam(model.parameters(), lr=0.001)\n",
        "    epochs = 3     # FIX ME: 3\n",
        "    if criterion is None or optimizer is None or epochs is None:\n",
        "        print(\"[BELUM LENGKAP] Lengkapkan criterion, optimizer dan epochs.\")"
      ],
      "id": "W2rbjzXos6Ak"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "toKOzkuJs6Al"
      },
      "source": [
        "# 8. Train Model"
      ],
      "id": "toKOzkuJs6Al"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "3a3OdEu5s6Al",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "c54243c2-e060-4f33-b18a-9ed9355b7ca0"
      },
      "execution_count": 9,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Epoch 1/3: Loss=2.7997, Accuracy=0.4667\n",
            "Epoch 2/3: Loss=2.7772, Accuracy=0.4833\n",
            "Epoch 3/3: Loss=2.7721, Accuracy=0.5000\n"
          ]
        }
      ],
      "source": [
        "if model is None or train_loader is None or criterion is None or optimizer is None or epochs is None:\n",
        "    print(\"[BELUM SEDIA] Lengkapkan dataset, model dan training setup dahulu.\")\n",
        "    training_complete = False\n",
        "else:\n",
        "    for epoch in range(epochs):\n",
        "        model.train(); running_loss = 0.0; correct = 0; total = 0\n",
        "        for images, labels in train_loader:\n",
        "            images, labels = images.to(device), labels.to(device)\n",
        "            optimizer.zero_grad()\n",
        "            outputs = model(images)\n",
        "            loss = criterion(outputs, labels)\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "            running_loss += loss.item()\n",
        "            predicted = torch.argmax(outputs, dim=1)\n",
        "            correct += (predicted == labels).sum().item(); total += labels.size(0)\n",
        "        accuracy = correct / total if total else 0\n",
        "        print(f\"Epoch {epoch+1}/{epochs}: Loss={running_loss:.4f}, Accuracy={accuracy:.4f}\")\n",
        "    training_complete = True"
      ],
      "id": "3a3OdEu5s6Al"
    },
