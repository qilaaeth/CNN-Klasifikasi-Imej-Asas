# Training Loss Analysis

plt.figure(figsize=(8, 5))
plt.plot(
    range(1, epochs + 1),
    train_losses,
    marker='o'
)

plt.title("Training Loss")
plt.xlabel("Epoch")
plt.ylabel("Loss")
plt.xticks(range(1, epochs + 1))
plt.grid(True)
plt.show()

# Training Accuracy Analysis

plt.figure(figsize=(8, 5))
plt.plot(
    range(1, epochs + 1),
    train_accuracies,
    marker='o'
)

plt.title("Training Accuracy")
plt.xlabel("Epoch")
plt.ylabel("Accuracy")
plt.xticks(range(1, epochs + 1))
plt.grid(True)
plt.show()
